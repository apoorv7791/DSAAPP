{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
     "env": {
        "EXPO_PUBLIC_BACKEND_URL": "http://192.168.1.6:4000",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://www.google.com"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
