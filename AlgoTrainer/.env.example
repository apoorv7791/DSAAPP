# Copy to `.env` for local Expo. Values are public client keys only; still avoid committing `.env`.
# For EAS production builds, set the same variables in Expo / EAS (see docs/RELEASE_ANDROID.md).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: HTTPS URLs you host (e.g. upload docs/legal/*.html to static hosting).
# Shown as “open in browser” links in Support screens and should match your Play listing URL.
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-domain.example/privacy-policy.html
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://your-domain.example/terms-of-service.html
